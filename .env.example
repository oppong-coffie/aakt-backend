# Database Configuration
MONGODB_URI=mongodb://localhost:27017/aakt

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Email Configuration (Optional)
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here

# Native AAKT AI Assistant (Optional)
# Uses an OpenAI-compatible /chat/completions endpoint. If no key is set,
# the assistant still works with deterministic read summaries and safe action previews.
AAKT_AI_API_KEY=
AAKT_AI_BASE_URL=https://api.openai.com/v1
AAKT_AI_MODEL=gpt-4o-mini
